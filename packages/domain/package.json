  "engines": {
    "node": "^22.0.0"
  },
  "license": "UNLICENSED",
  "packageManager": "yarn@4.7.0",
  "name": "@intern/domain",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "check": "yarn lint && yarn prettier",
    "clean": "del ./lib \"npm-debug.log*\" ./doc ./coverage ./.nyc_output",
    "test": "yarn check && tsjest",
    "tsjest": "yarn jest --runInBand",
    "lint": "eslint --ext .ts src/",
    "preversion": "yarn clean && yarn build && yarn test",
    "prepublishOnly": "yarn clean && yarn build && yarn test",
    "version": "git add -A",
    "postversion": "git push origin --tags",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.ts\"",
    "versionup": "node auto-versioning"
  },
  "version": "0.0.1"
