{
  "name": "intern-nodejs-source",
  "version": "0.0.1",
  "main": "index.js",
  "license": "UNLICENSED",
  "packageManager": "yarn@4.7.0",
  "workspaces": [
    "apps/api",
    "apps/front",
    "packages/domain",
    "packages/factory",
    "packages/migration"
  ],
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "lint": "eslint \"{packages,apps}/*/src/**/*.{ts,vue,tsx}\" \"apps/front/**/*.{ts,vue,tsx}\" --ignore-pattern '**/.*'",
    "lint:fix": "eslint \"{packages,apps}/*/src/**/*.{ts,vue,tsx}\" \"apps/front/**/*.{ts,vue,tsx}\"  --ignore-pattern '**/.*' --fix",
    "prettier": "prettier --check \"{packages,apps}/*/src/**/*.{ts,vue,tsx}\"  \"apps/front/**/*.{ts,vue,tsx}\"",
    "format": "prettier --write \"{packages,apps}/*/src/**/*.{ts,vue,tsx}\"  \"apps/front/**/*.{ts,vue,tsx}\"",
    "dev:api": "yarn workspace @intern/api dev",
    "dev:front": "yarn workspace @intern/front dev",
    "build:domain": "yarn workspace @intern/domain build",
    "build:factory": "yarn workspace @intern/factory build",
    "build:front": "yarn workspace @intern/front build",
    "build:api": "yarn workspace @intern/api build"
  },
  "devDependencies": {
    "@types/node": "^22.13.13",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.5.3",
    "typescript": "5.7.3",
    "vue-eslint-parser": "^10.1.3"
  },
  "dependencies": {
    "@types/multer": "^2.0.0",
    "csv-parse": "^6.1.0",
    "dayjs": "^1.11.13",
    "http-status-codes": "^2.3.0",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "primevue": "4.3.3"
  },
  "_moduleAliases": {
    "@factory": "dst/packages/factory/src",
    "@domain": "dst/packages/domain/src"
  },
  "resolutions": {
    "express": "4.21.2",
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.17.33"
  }
}
